# Copy this file to ".env" and change values if needed.

# Port the Express API listens on
PORT=5000

# MongoDB connection string (local MongoDB Community Server by default)
MONGODB_URI=mongodb://127.0.0.1:27017/final_capstone_db

# Secret used to sign login tokens (JWT). CHANGE THIS to any long random text.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Python AI service (Flask) address
AI_SERVICE_URL=http://127.0.0.1:8000

# Allowed browser origin for the React dev server (comma-separated for several)
CLIENT_ORIGIN=http://localhost:5173

# Gmail: enable 2-Step Verification and create a Google App Password.